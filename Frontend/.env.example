# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# Backend API origin used by the Vite dev server proxy (local development).
# Example: https://localhost:7023 (local ASP.NET backend)
BACKEND_API_URL=

# Backend API origin injected into the client bundle at build time.
# Read via import.meta.env.API_BASE_URL — leave empty locally to use the
# relative /api path (proxied by the dev server). In production this is set
# in Vercel Project Settings (no VITE_ prefix, no hardcoded URLs in code).
API_BASE_URL=
